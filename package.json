{
  "name": "cv-paper-platform",
  "version": "1.0.0",
  "private": true,
  "description": "CVPR/ICCV/ECCV 论文分析平台 —— 与 AI 结对完成",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "node server/index.js",
    "start": "node server/index.js",
    "lint": "eslint src server --ext .js,.vue --fix --max-warnings=0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "echarts": "^5.5.1",
    "express": "^4.21.2",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}